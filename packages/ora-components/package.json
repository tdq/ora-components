{
  "name": "@tdq/ora-components",
  "version": "0.1.8",
  "description": "Ora web components library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdq/ora-components.git",
    "directory": "packages/ora-components"
  },
  "bugs": {
    "url": "https://github.com/tdq/ora-components/issues"
  },
  "homepage": "https://github.com/tdq/ora-components/tree/main/packages/ora-components#readme",
  "author": "1A Platform Team",
  "keywords": [
    "typescript",
    "rxjs",
    "tailwind-css",
    "material-design-3",
    "reactive-ui",
    "builder-pattern",
    "ora"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "import": "./dist/ora-components.css",
      "default": "./dist/ora-components.css"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "import": "./dist/chart/index.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "import": "./dist/chat/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "import": "./dist/checkbox/index.js"
    },
    "./combobox": {
      "types": "./dist/combobox/index.d.ts",
      "import": "./dist/combobox/index.js"
    },
    "./datepicker": {
      "types": "./dist/datepicker/index.d.ts",
      "import": "./dist/datepicker/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "import": "./dist/dialog/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "import": "./dist/grid/index.js"
    },
    "./label": {
      "types": "./dist/label/index.d.ts",
      "import": "./dist/label/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./listbox": {
      "types": "./dist/listbox/index.d.ts",
      "import": "./dist/listbox/index.js"
    },
    "./numberfield": {
      "types": "./dist/numberfield/index.d.ts",
      "import": "./dist/numberfield/index.js"
    },
    "./panel": {
      "types": "./dist/panel/index.d.ts",
      "import": "./dist/panel/index.js"
    },
    "./sidebar": {
      "types": "./dist/sidebar/index.d.ts",
      "import": "./dist/sidebar/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "import": "./dist/tabs/index.js"
    },
    "./textfield": {
      "types": "./dist/textfield/index.d.ts",
      "import": "./dist/textfield/index.js"
    },
    "./toolbar": {
      "types": "./dist/toolbar/index.d.ts",
      "import": "./dist/toolbar/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "QUICKSTART.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:css && npm run build:types && node scripts/reorganize-types.mjs && node scripts/generate-manifest.mjs && node scripts/add-nodenext-extensions.mjs",
    "build:css": "tailwindcss -i ./src/index-base.css -o ./dist/ora-components-base.css --minify && tailwindcss -i ./src/index-layered.css -o ./dist/ora-components-layered.css --minify && node scripts/wrap-css-layer.mjs compose ./dist/ora-components-base.css ./dist/ora-components-layered.css ./dist/ora-components.css",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "jest",
    "preverify": "npm run build:css",
    "verify": "node scripts/check-css-globals.mjs && node scripts/check-theme-tokens.mjs && node scripts/check-docs-vs-manifest.mjs && node scripts/check-quickstart.mjs",
    "pack:local": "npm run build && npm pack"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "autoprefixer": "^10.4.24",
    "clsx": "^2.1.1",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.10"
  },
  "browserslist": [
    "defaults",
    "safari >= 16",
    "ios_saf >= 16"
  ]
}
